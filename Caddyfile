{$DOMAIN} {
	encode zstd gzip

	# Batas unggah aplikasi 10 MB; diberi kelonggaran untuk overhead multipart.
	request_body {
		max_size 12MB
	}

	header {
		# HSTS kini ditetapkan aplikasi (next.config.ts), supaya ikut ke mana
		# pun ia dijalankan — termasuk di balik proxy lain seperti Traefik.
		-Server
	}

	reverse_proxy app:3000 {
		# Menimpa, bukan menambah: tanpa ini rantai X-Forwarded-For diawali
		# nilai kiriman klien, dan rate limit login bisa dilewati dengan
		# memalsukan header.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}
